# agenda-knowledge-base configuration.
#
# Copy to .env and fill in. The server, the scripts and both MCP servers load
# this file themselves (server/env.js); a variable already set in the
# environment (systemd, shell) always wins over the file.
# Only AGENDA_TOKEN is strictly required. Without an LLM key the app works as a
# plain outliner and the assistant answers with an error.

# --- Server -------------------------------------------------------------------

# Shared secret for the web app, the API and the MCP bridge. Long and random:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENDA_TOKEN=change-me-to-a-long-random-string

# Listen address and port. Keep 127.0.0.1 behind a reverse proxy on the same
# machine; use the docker bridge gateway (e.g. 172.17.0.1) if the proxy runs in
# a container.
HOST=127.0.0.1
PORT=8137

# The agenda computes "today" on the process clock: set your own time zone.
TZ=Europe/Paris

# Optional: your first name, used in the agent's system prompt.
AGENDA_USER_NAME=

# --- Data (all default to ./data, created on first run) -------------------------

# AGENDA_DATA_DIR=./data
# AGENDA_DB=./data/todo.db            # tasks, rules, facts, chat, history
# AGENDA_FILES=./data/files           # uploaded images and files
# AGENDA_KB=./data/kb                 # knowledge base: markdown notes (source of truth)
# AGENDA_KB_DB=./data/kb.db           # knowledge base index (rebuilt from the files)
# AGENDA_WORKERS_DIR=./data/workers   # worker logs and state
# AGENDA_BACKUP_DIR=./data/backups    # archives made by scripts/weave.mjs
# AGENDA_UPLOAD_MAX=10485760          # max upload size in bytes
# AGENDA_ENV_FILE=./.env              # where this file is read from

# --- LLM (any OpenAI-compatible /chat/completions endpoint) ----------------------

# Default provider: OpenCode Go. Examples for others:
#   OpenRouter: AGENDA_LLM_URL=https://openrouter.ai/api/v1   AGENDA_MODEL=deepseek/deepseek-chat
#   Mistral:    AGENDA_LLM_URL=https://api.mistral.ai/v1      AGENDA_MODEL=mistral-medium-latest
# The model must support tool calling. Check a candidate with scripts/bench-model.mjs.
AGENDA_LLM_URL=https://opencode.ai/zen/go/v1
AGENDA_LLM_API_KEY=your-llm-api-key
AGENDA_MODEL=deepseek-v4.1-flash
# Optional fallback model, used once when the main one answers 404/410 (retired).
AGENDA_MODEL_FALLBACK=
# reasoning_effort sent with each call (low | medium | high | none, empty to omit).
AGENDA_REASONING=low
# AGENDA_MAX_TURNS=24                 # max tool rounds per chat message
# AGENDA_LLM_TIMEOUT=480000           # ms
# OPENCODE_GO_API_KEY=                # accepted as an alias of AGENDA_LLM_API_KEY

# Image description (attachments). Same key as above, OpenAI image_url format.
# AGENDA_VISION_URL=                  # defaults to AGENDA_LLM_URL
AGENDA_VISION_MODEL=deepseek-v4-flash-vision-exp
# AGENDA_VISION_TIMEOUT=180000        # ms

# --- Knowledge base -----------------------------------------------------------------

# Folders of "timeless" notes that must never talk about your ongoing projects.
KB_TIMELESS_DIRS=knowledge
# Folder prefixes excluded from search and routing candidates (raw transcripts...).
KB_EXCLUDED_DIRS=knowledge/sources/
# Router (kb_route) and project filing; models default to AGENDA_MODEL.
# KB_ROUTER_URL=                      # defaults to AGENDA_LLM_URL
# KB_ROUTER_MODEL=
# KB_ROUTER_TIMEOUT=12000
# KB_ROUTER_CANDIDATES=25
# KB_ROUTER_LOG=./data/kb/router-log.jsonl
# KB_PROJECTS_MODEL=
# KB_PROJECTS_TIMEOUT=12000

# --- Voice dictation (speech to text) ---------------------------------------------

# Mistral Voxtral. Without a key the microphone button is hidden.
MISTRAL_API_KEY=
# AGENDA_STT_URL=https://api.mistral.ai/v1/audio/transcriptions
# AGENDA_STT_MODEL=voxtral-mini-latest
# Language forced on transcription (ISO 639-1), empty for auto-detection.
AGENDA_STT_LANGUAGE=fr
# Comma-separated proper nouns you say often, to help spelling.
AGENDA_STT_PROMPT=

# --- Google Calendar mirror (read-only, via secret iCal URLs) --------------------

# Google Calendar > Settings > (calendar) > Integrate calendar >
# "Secret address in iCal format". Several URLs: comma-separated.
AGENDA_GCAL_ICS=

# --- Link previews -------------------------------------------------------------------

# AGENDA_LINK_TIMEOUT=8000            # ms to fetch a page title/description

# --- Worker ("send to a worker" button) -------------------------------------------------

# A Claude Code compatible CLI run headless (`-p ... --dangerously-skip-permissions`).
# It runs with the server's user rights, in AGENDA_WORKER_CWD: only enable it on
# a machine you own.
AGENDA_WORKER_CMD=claude
AGENDA_WORKER_CWD=
# Model of the second worker, "Claude Code · cheap model" (same binary, plus
# --model). With OPENCODE_GO_API_KEY set it runs on OpenCode Go, default
# deepseek-v4.1-flash; otherwise on Anthropic, default claude-haiku-5-5.
# AGENDA_WORKER_CHEAP_MODEL=
# AGENDA_WORKER_TIMEOUT_MS=720000
# AGENDA_WORKER_MAX_TURNS=30

# --- MCP bridge -----------------------------------------------------------------------

# URL of the running service, used by mcp/agenda.js (agenda_message).
# Defaults to http://HOST:PORT from this file.
# AGENDA_URL=http://127.0.0.1:8137

# --- Benchmarks -----------------------------------------------------------------------

# BENCH_REPETITIONS=2
